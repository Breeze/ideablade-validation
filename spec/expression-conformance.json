{
  "$comment": "Shared conformance cases for the safe expression evaluator. Run by both the TypeScript (js/test) and .NET (dotnet/test) test suites so both implementations stay in sync. 'expected' is compared with loose numeric equality (1 == 1.0). 'error' is 'syntax' (rejected at parse time) or 'evaluation' (rejected at run time).",
  "scope": {
    "model": {
      "id": 7,
      "name": "Widget",
      "code": "ab-12",
      "price": 12.5,
      "quantity": 3,
      "active": true,
      "notes": null,
      "tags": ["red", "blue"],
      "address": { "city": "Oakland", "zip": "94612" },
      "items": [
        { "key": "Color", "value": "red", "qty": 2 },
        { "key": "Size", "value": "L", "qty": 5 }
      ],
      "amountText": "1,234.50",
      "startYear": 2024,
      "startMonth": 2,
      "startDay": 15
    },
    "context": { "displayName": "Name", "minValue": 1, "maxValue": 10, "tenantKey": "Color" },
    "isClient": true,
    "isServer": false
  },
  "cases": [
    { "expr": "true", "expected": true },
    { "expr": "1 + 2 * 3", "expected": 7 },
    { "expr": "(1 + 2) * 3", "expected": 9 },
    { "expr": "10 % 4", "expected": 2 },
    { "expr": "-model.quantity", "expected": -3 },
    { "expr": "'a' + 'b'", "expected": "ab" },
    { "expr": "\"x\" + 1", "expected": "x1" },
    { "expr": "model.name", "expected": "Widget" },
    { "expr": "model['name']", "expected": "Widget" },
    { "expr": "model.address.city", "expected": "Oakland" },
    { "expr": "model.tags[1]", "expected": "blue" },
    { "expr": "model.tags.length", "expected": 2 },
    { "expr": "model.name.length", "expected": 6 },
    { "expr": "model.notes == null", "expected": true },
    { "expr": "model.notes === null", "expected": true },
    { "expr": "model.missing === undefined", "expected": true },
    { "expr": "model.notes?.length", "expected": null, "$comment": "undefined; serialized as null" },
    { "expr": "model.notes?.foo.bar.baz", "expected": null },
    { "expr": "model.address?.city", "expected": "Oakland" },
    { "expr": "model.notes ?? 'none'", "expected": "none" },
    { "expr": "model.quantity ?? 0", "expected": 3 },
    { "expr": "model.active && model.quantity > 2", "expected": true },
    { "expr": "!model.active || model.quantity > 5", "expected": false },
    { "expr": "!!model.name", "expected": true },
    { "expr": "!!(model.notes)", "expected": false },
    { "expr": "model.quantity > 2 ? 'many' : 'few'", "expected": "many" },
    { "expr": "model.price >= context.minValue && model.price <= context.maxValue", "expected": false },
    { "expr": "model.quantity === 3", "expected": true },
    { "expr": "model.quantity !== 3", "expected": false },
    { "expr": "model.quantity == '3'", "expected": true },
    { "expr": "model.quantity != '3'", "expected": false },
    { "expr": "isClient && !isServer", "expected": true },
    { "expr": "typeof model.name === 'string'", "expected": true },
    { "expr": "typeof notDefined", "expected": "undefined" },
    { "expr": "model.code.toUpperCase()", "expected": "AB-12" },
    { "expr": "model.code.toLowerCase() === 'ab-12'", "expected": true },
    { "expr": "model.code.startsWith('ab')", "expected": true },
    { "expr": "model.code.endsWith('12')", "expected": true },
    { "expr": "model.code.includes('-')", "expected": true },
    { "expr": "model.code.indexOf('-')", "expected": 2 },
    { "expr": "model.code.substring(0, 2)", "expected": "ab" },
    { "expr": "' x '.trim()", "expected": "x" },
    { "expr": "model.tags.includes('red')", "expected": true },
    { "expr": "model.tags.join('|')", "expected": "red|blue" },
    { "expr": "model.items.some(i => i.qty > 4)", "expected": true },
    { "expr": "model.items.every(i => i.qty > 4)", "expected": false },
    { "expr": "model.items.find(i => i.key === context.tenantKey).value", "expected": "red" },
    { "expr": "model.items.find(e => e.key.toLowerCase() === 'size')?.value", "expected": "L" },
    { "expr": "model.items.find(e => e.key === 'Nope')?.value", "expected": null },
    { "expr": "model.items.filter(i => i.qty > 1).length", "expected": 2 },
    { "expr": "model.items.map(i => i.qty).reduce((a, b) => a + b, 0)", "expected": 7 },
    { "expr": "model.items.findIndex(i => i.key === 'Size')", "expected": 1 },
    { "expr": "[1, 2, 3].includes(2)", "expected": true },
    { "expr": "[1, 2, 3].length", "expected": 3 },
    { "expr": "Math.max(1, model.quantity, 2)", "expected": 3 },
    { "expr": "Math.round(2.5)", "expected": 3 },
    { "expr": "Math.abs(-4)", "expected": 4 },
    { "expr": "Math.floor(model.price)", "expected": 12 },
    { "expr": "parseFloat(model.amountText.replace(/,+/g, ''))", "expected": 1234.5 },
    { "expr": "0 <= parseFloat(model.amountText.toString().replace(/,+/g, ''))", "expected": true },
    { "expr": "parseInt('42')", "expected": 42 },
    { "expr": "Number('7') + 1", "expected": 8 },
    { "expr": "String(5) + 'x'", "expected": "5x" },
    { "expr": "isNaN(parseFloat('abc'))", "expected": true },
    { "expr": "/^[a-z]{2}-\\d+$/.test(model.code)", "expected": true },
    { "expr": "/^AB/i.test(model.code)", "expected": true },
    { "expr": "model.price / 2 > 6", "expected": true },
    { "expr": "new Date(model.startYear, model.startMonth - 1, model.startDay).getFullYear()", "expected": 2024 },
    { "expr": "new Date(model.startYear, model.startMonth - 1, model.startDay).getMonth()", "expected": 1 },
    { "expr": "new Date(model.startYear, model.startMonth - 1, model.startDay).getDate()", "expected": 15 },
    { "expr": "new Date(2020, 0, 1) < new Date(2021, 0, 1)", "expected": true },
    { "expr": "new Date(2020, 0, 1) < Date.now()", "expected": true },
    { "expr": "Date.now() > 0", "expected": true },
    { "expr": "Array.isArray(model.tags)", "expected": true },
    { "expr": "Object.keys(model.address).length", "expected": 2 },
    { "expr": "{ a: 1, b: model.quantity }.b", "expected": 3 },
    { "expr": "(x => x * 2)(4)", "expected": 8 },
    { "expr": "((a, b) => a + b)(2, 3)", "expected": 5 },
    { "expr": "`plain template`", "expected": "plain template" },
    { "expr": "1_000 + 0.5", "expected": 1000.5 },
    { "expr": "0x10", "expected": 16 },

    { "expr": "", "error": "syntax" },
    { "expr": "model.name = 'x'", "error": "syntax" },
    { "expr": "model.quantity++", "error": "syntax" },
    { "expr": "function() { return 1 }", "error": "syntax" },
    { "expr": "this.foo", "error": "syntax" },
    { "expr": "new Function('return 1')", "error": "syntax" },
    { "expr": "new RegExp('a')", "error": "syntax" },
    { "expr": "eval('1')", "error": "syntax" },
    { "expr": "x => { return 1 }", "error": "syntax" },
    { "expr": "`${model.name}`", "error": "syntax" },
    { "expr": "a; b", "error": "syntax" },
    { "expr": "delete model.name", "error": "syntax" },
    { "expr": "'name' in model", "error": "syntax" },
    { "expr": "model.(name)", "error": "syntax" },
    { "expr": "(1 + 2", "error": "syntax" },
    { "expr": "[...model.tags]", "error": "syntax" },
    { "expr": "{ __proto__: 1 }", "error": "syntax" },

    { "expr": "unknownThing", "error": "evaluation" },
    { "expr": "model.constructor", "error": "evaluation" },
    { "expr": "model['constr' + 'uctor']", "error": "evaluation" },
    { "expr": "model.__proto__", "error": "evaluation" },
    { "expr": "model.name.constructor", "error": "evaluation" },
    { "expr": "model.tags.constructor('return 1')", "error": "evaluation" },
    { "expr": "Math.constructor", "error": "evaluation" },
    { "expr": "parseInt.call(null, '1')", "error": "evaluation" },
    { "expr": "model.tags.push('green')", "error": "evaluation" },
    { "expr": "model.tags.sort()", "error": "evaluation" },
    { "expr": "model.items.splice(0, 1)", "error": "evaluation" },
    { "expr": "new Date().setFullYear(2000)", "error": "evaluation" },
    { "expr": "'x'.repeat(10)", "error": "evaluation" },
    { "expr": "'x'.padStart(1000000000)", "error": "evaluation" },
    { "expr": "model.notes.length", "error": "evaluation" },
    { "expr": "model.address.toString()", "error": "evaluation" },
    { "expr": "Math.random()", "error": "evaluation" },
    { "expr": "Date.foo()", "error": "evaluation" },
    { "expr": "model.name()", "error": "evaluation" },
    { "expr": "(f => f(f))(f => f(f))", "error": "evaluation" }
  ]
}
